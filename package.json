{
  "name": "klean-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Klean UI: copied-source, durable UI for The Boring JavaScript Stack",
  "keywords": [
    "sails",
    "boring-stack",
    "tailwindcss",
    "vue",
    "react",
    "svelte",
    "components"
  ],
  "homepage": "https://docs.sailscasts.com/klean-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailscastshq/klean-ui.git"
  },
  "bugs": {
    "url": "https://github.com/sailscastshq/klean-ui/issues"
  },
  "bin": {
    "klean-ui": "./bin/klean-ui.js"
  },
  "files": [
    "bin",
    "cli",
    "registry",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.6",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.6",
    "@rstest/core": "^0.11.6",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/vue3": "^10.5.6",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "storybook": "^10.5.6",
    "storybook-addon-rslib": "^3.4.0",
    "storybook-vue3-rsbuild": "^3.4.0",
    "svelte": "^5.49.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
