{
  "name": "klean-ui",
  "version": "0.0.1",
  "type": "module",
  "description": "Klean UI: copied-source, durable UI for The Boring JavaScript Stack",
  "keywords": [
    "sails",
    "boring-stack",
    "tailwindcss",
    "vue",
    "react",
    "svelte",
    "components"
  ],
  "homepage": "https://docs.sailscasts.com/klean-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sailscastshq/klean-ui.git"
  },
  "bugs": {
    "url": "https://github.com/sailscastshq/klean-ui/issues"
  },
  "bin": {
    "klean-ui": "./bin/klean-ui.js"
  },
  "files": [
    "bin",
    "cli",
    "registry",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "registry:lineage": "node scripts/update-registry-lineage.mjs",
    "registry:lineage:check": "node scripts/update-registry-lineage.mjs --check",
    "lint:tailwind": "node scripts/check-tailwind-canonical.mjs",
    "storybook": "node scripts/storybook.js dev",
    "storybook:host": "storybook dev --config-dir .storybook --port 6006 --no-open",
    "storybook:vue": "storybook dev --config-dir .storybook-vue --port 6007 --no-open",
    "storybook:react": "storybook dev --config-dir .storybook-react --port 6008 --no-open",
    "storybook:svelte": "storybook dev --config-dir .storybook-svelte --port 6009 --no-open",
    "build-storybook": "node scripts/storybook.js build"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.6",
    "@floating-ui/dom": "^1.8.0",
    "@inertiajs/react": "^3.6.1",
    "@inertiajs/svelte": "^3.6.1",
    "@inertiajs/vue3": "^3.6.1",
    "@internationalized/date": "^3.12.3",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.6",
    "@rstest/core": "^0.11.6",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/svelte-vite": "^10.4.6",
    "@storybook/vue3": "10.4.6",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/test-utils": "^2.4.11",
    "axios": "^1.19.0",
    "chrono-node": "^2.10.1",
    "happy-dom": "^20.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "10.4.6",
    "storybook-addon-rslib": "3.3.0",
    "storybook-builder-rsbuild": "3.3.0",
    "storybook-react-rsbuild": "^3.3.0",
    "storybook-vue3-rsbuild": "3.3.0",
    "svelte": "^5.49.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue": "^3.5.41"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
