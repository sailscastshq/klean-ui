{
  "$schema": "../schema.json",
  "name": "field",
  "description": "The accessible form-field convention that wires native labels, controls, descriptions, and errors together.",
  "registryDependencies": ["field-context", "label", "input", "textarea"],
  "frameworks": {
    "vue": {
      "source": "vue/Field.vue",
      "target": "field/Field.vue",
      "dependencies": { "tailwind-merge": "^3.6.0" }
    },
    "react": {
      "source": "react/Field.jsx",
      "target": "field/Field.jsx",
      "dependencies": { "tailwind-merge": "^3.6.0" }
    },
    "svelte": {
      "source": "svelte/Field.svelte",
      "target": "field/Field.svelte",
      "dependencies": { "tailwind-merge": "^3.6.0" }
    }
  }
}
