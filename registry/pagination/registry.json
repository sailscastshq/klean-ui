{
  "$schema": "../schema.json",
  "name": "pagination",
  "description": "Durable server pagination with framework-native Inertia links, canonical URLs, and accessible navigation defaults.",
  "frameworks": {
    "vue": {
      "source": "vue/Pagination.vue",
      "target": "pagination/Pagination.vue",
      "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "tailwind-merge": "^3.6.0"
      }
    },
    "react": {
      "source": "react/Pagination.jsx",
      "target": "pagination/Pagination.jsx",
      "dependencies": {
        "@inertiajs/react": "^3.6.1",
        "tailwind-merge": "^3.6.0"
      }
    },
    "svelte": {
      "source": "svelte/Pagination.svelte",
      "target": "pagination/Pagination.svelte",
      "dependencies": {
        "@inertiajs/svelte": "^3.6.1",
        "tailwind-merge": "^3.6.0"
      }
    }
  }
}
