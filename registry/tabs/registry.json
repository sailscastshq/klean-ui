{
  "$schema": "../schema.json",
  "name": "tabs",
  "description": "Durable tabs that enhance caller-owned buttons as peer panels and anchors or framework Links as truthful navigation.",
  "frameworks": {
    "vue": {
      "source": "vue/Tabs.vue",
      "target": "tabs/Tabs.vue",
      "dependencies": { "tailwind-merge": "^3.6.0" }
    },
    "react": {
      "source": "react/Tabs.jsx",
      "target": "tabs/Tabs.jsx",
      "dependencies": { "tailwind-merge": "^3.6.0" }
    },
    "svelte": {
      "source": "svelte/Tabs.svelte",
      "target": "tabs/Tabs.svelte",
      "dependencies": { "tailwind-merge": "^3.6.0" }
    }
  }
}
