{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klean-ui.sailscasts.com/registry/schema.json",
  "title": "Klean UI registry item",
  "type": "object",
  "required": ["name", "description", "frameworks"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["component", "icon", "utility"],
      "default": "component"
    },
    "registryDependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "frameworks": {
      "type": "object",
      "required": ["vue", "react", "svelte"],
      "additionalProperties": false,
      "properties": {
        "vue": { "$ref": "#/$defs/framework" },
        "react": { "$ref": "#/$defs/framework" },
        "svelte": { "$ref": "#/$defs/framework" }
      }
    }
  },
  "$defs": {
    "framework": {
      "type": "object",
      "required": ["dependencies"],
      "properties": {
        "source": { "type": "string" },
        "target": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["source", "target"],
            "properties": {
              "source": { "type": "string" },
              "target": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "oneOf": [
        { "required": ["source", "target"] },
        { "required": ["files"] }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
